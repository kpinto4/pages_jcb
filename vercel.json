{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/pages_jcb/browser",
  "installCommand": "npm run vercel-install",
  "framework": "angular",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/api", "destination": "/api" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
