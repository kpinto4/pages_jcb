# Copia este archivo a .env y rellena los valores.
# cp .env.example .env
#
# IMPORTANTE: el backend carga ÚNICAMENTE server/.env (ver dotenv.config en index.js).
# Un .env en la raíz del proyecto NO se lee: editarlo no cambia nada.

# Puerto del backend. Local con npm run dev: 3012 (Frontend=3015, Backend=3012).
PORT=3012

# Base de datos (obligatoria): siempre se usa PostgreSQL
# Neon: usa la URL con -pooler en el host (Connection pooling)
# Ejemplo: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ========== Acceso al panel de administración (obligatorio) ==========
# Contraseña para entrar al panel en /admin. En producción debe estar definida o el servidor no arranca.
ADMIN_PASSWORD=

# Secreto para firmar los JWT de sesión. Recomendado: un valor distinto a ADMIN_PASSWORD.
# Si no se define, se usa ADMIN_PASSWORD. En producción conviene definir ambos.
JWT_SECRET=

# CORS: en producción pon el origen permitido (ej. https://tudominio.com). Vacío = aceptar cualquier origen.
# ALLOWED_ORIGIN=

# Órdenes de compra en "pending" (reservaron stiker y no pagaron): se liberan a los N minutos (5–30). Por defecto 30.
# PENDING_ORDER_EXPIRE_MINUTES=30

# Máximo de stikers por compra (1–100). Por defecto 50.
# MAX_STICKERS_PER_ORDER=50

# ----- Correo (comprobantes tras pago) — SpaceMail -----
# SMTP_HOST=mail.spacemail.com
# SMTP_PORT=465
# SMTP_USER=no_reply@inversionesjcb.online
# SMTP_PASS=
# EMAIL_FROM=no_reply@inversionesjcb.online
# 465 = SSL. 535 5.7.8 = contraseña incorrecta o IMAP/SMTP/POP3 desactivado en SpaceMail.

# ----- Enlaces públicos (opcional; los consume el frontend vía GET /api/config) -----
# WhatsApp: wa.me o https://chat.whatsapp.com/...
# PUBLIC_WHATSAPP_DUDAS_URL=https://wa.me/573187936740
# PUBLIC_WHATSAPP_COMUNIDAD_URL=
# PUBLIC_SOCIAL_FACEBOOK_URL=https://www.facebook.com/share/1LgDzheb4T/?mibextid=wwXIfr
# PUBLIC_SOCIAL_INSTAGRAM_URL=https://www.instagram.com/juegoslaciudadbonita_
# PUBLIC_SOCIAL_TIKTOK_URL=https://www.tiktok.com/@tu-usuario

# URL pública del backend (obligatorio en despliegue). Evita que las imágenes usen localhost y fallen por CORS.
# Debe ser la misma URL donde corre el API (ej. http://n1.voriamtechnologies.com:3012).
PUBLIC_API_URL=

# ========== Wompi (Colombia) – pasarela de pago ==========
# Dashboard: https://comercios.wompi.co → Desarrolladores.
# Pruebas sin cobro real: llaves sandbox (public-key pub_test_*). Producción: pub_prod_* (o el prefijo que indique Wompi para prod).
# En producción (NODE_ENV=production) la ruta "Simular pago" del backend está desactivada; usa siempre Wompi (sandbox o prod según estas claves).
# En local, si no configuras Wompi, puedes usar "Simular pago" en la UI solo cuando NODE_ENV no sea production.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# URL del checkout (por defecto https://checkout.wompi.co/p/)
# WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
# Para que tras pagar Wompi redirija a tu app: URL pública del frontend (puerto 3015). En producción usa tu dominio real.
# Ejemplo producción: http://n1.voriamtechnologies.com:3015/comprar-stikers?success=true&session_id={CHECKOUT_SESSION_ID}
# WOMPI_SUCCESS_URL=
