# Copia este archivo a .env y rellena los valores.
# cp .env.example .env

# Puerto (opcional, por defecto 3000)
PORT=3000

# Base de datos: sin DATABASE_URL se usa SQLite local
# Neon: usa la URL con -pooler en el host (Connection pooling)
# Ejemplo: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Ruta del archivo SQLite solo si no usas DATABASE_URL (opcional)
# SQLITE_PATH=./data.db

# Admin: contraseña para el panel /admin (obligatoria en producción)
ADMIN_PASSWORD=

# JWT: secreto para firmar sesiones. Cualquier valor no vacío vale.
# Si no se define, se usa ADMIN_PASSWORD. Sin restricción de longitud.
JWT_SECRET=

# Stripe (opcional; si no se usa, los pagos no estarán disponibles)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Vercel Blob: token para subir imágenes en producción (opcional)
# BLOB_READ_WRITE_TOKEN=
